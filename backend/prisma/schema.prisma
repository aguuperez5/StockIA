generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}



model User {
  id        Int      @id @default(autoincrement())
  name      String
  legajo    String   @default("")
  email     String   @unique
  password  String
  role      Role     @default(USER)
  appRole   String   @default("caja")
  createdAt DateTime @default(now())

  sales Sale[]
  telegramOffers TelegramOffer[]
  transfersCreated Transfer[] @relation("TransferCreator")

  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  category  String?
  price     Decimal  @db.Decimal(10, 2)
  lowStockThreshold Int @default(5)
  imageUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceRules      PriceRule[]
  stocks          Stock[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  transferItems   TransferItem[]

  @@map("products")
}

model PriceRule {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  price       Decimal @db.Decimal(10, 2)

  @@unique([productId, minQuantity])
  @@index([productId])
  @@map("price_rules")
}

model Deposit {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  type      String   @default("Principal")
  address  String   @default("")
  manager  String   @default("")
  capacity Int      @default(0)
  imageUrl String?
  createdAt DateTime @default(now())

  stocks         Stock[]
  stockMovements StockMovement[]
  sales          Sale[]
  transfersOrigin Transfer[] @relation("TransferOrigin")
  transfersDestination Transfer[] @relation("TransferDestination")

  @@map("deposits")
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  depositId Int
  deposit   Deposit  @relation(fields: [depositId], references: [id], onDelete: Restrict)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([productId, depositId])
  @@index([depositId])
  @@map("stock")
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  depositId Int
  deposit   Deposit      @relation(fields: [depositId], references: [id], onDelete: Restrict)
  saleId    Int?
  sale      Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  quantity  Int

  reason    String?
  createdAt DateTime     @default(now())

  @@index([productId, depositId, createdAt])
  @@map("stock_movements")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("customers")
}

model Sale {
  id        Int        @id @default(autoincrement())
  depositId Int
  deposit   Deposit    @relation(fields: [depositId], references: [id], onDelete: Restrict)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId Int?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  total     Decimal    @db.Decimal(10, 2)
  photoData String?    @db.Text
  photoMimeType String?
  createdAt DateTime   @default(now())

  items SaleItem[]

  @@index([depositId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@index([saleId])
  @@map("sale_items")
}

model Transfer {
  id Int @id @default(autoincrement())
  originWarehouseId Int
  originWarehouse Deposit @relation("TransferOrigin", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouseId Int
  destinationWarehouse Deposit @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  status String @default("Confirmada")
  userId Int?
  creator User? @relation("TransferCreator", fields: [userId], references: [id], onDelete: SetNull)
  photoData String? @db.Text
  photoMimeType String?
  createdAt DateTime @default(now())
  items TransferItem[]

  @@index([originWarehouseId])
  @@index([destinationWarehouseId])
  @@map("transfers")
}

model TransferItem {
  id Int @id @default(autoincrement())
  transferId Int
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity Int

  @@index([transferId])
  @@map("transfer_items")
}

model TelegramOffer {
  id Int @id @default(autoincrement())
  message String
  status String
  productIds Json
  customerIds Json
  createdAt DateTime @default(now())
  userId Int?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("telegram_offers")
}
