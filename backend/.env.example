# Conexión a PostgreSQL (usada por Prisma vía prisma.config.ts y schema.prisma)
# Con el docker-compose.yml de la raíz del repo (servicio "postgres", puerto host 5434):
DATABASE_URL="postgresql://stockia:stockia@localhost:5434/stockia?schema=public"

# Puerto HTTP del servidor Express (server.js)
PORT=3000
