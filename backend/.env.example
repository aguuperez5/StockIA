DATABASE_URL="postgresql://stockia:stockia@localhost:5434/stockia?schema=public"
PORT=3001
# Clave secreta para firma JWT de sesiones (HS256).
# IMPORTANTE: En producción (NODE_ENV=production), la aplicación abortará el arranque
# si SESSION_SECRET o JWT_SECRET no están definidos o conservan el valor por defecto
# 'stockia-dev-secret-change-me'. Debe tener al menos 16 caracteres.
SESSION_SECRET="cambiame-por-una-clave-segura-de-produccion-minimo-16-caracteres"
JWT_SECRET="cambiame-por-una-clave-segura-de-produccion-minimo-16-caracteres"
FRONTEND_URL="http://localhost:3000"
AI_SERVICE_URL="http://127.0.0.1:8010"
# Debe coincidir con STOCKIA_AI_SHARED_TOKEN si se habilita autenticación.
# AI_SERVICE_TOKEN=""
AI_SERVICE_TIMEOUT_MS=15000
# Lectura pública sin API key. Identificá la app con un contacto al desplegar.
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org"
OPENFOODFACTS_USER_AGENT="StockIA/1.0 (local development)"
OPENFOODFACTS_TIMEOUT_MS=5000
# Para pruebas con staging: https://world.openfoodfacts.net (Basic off:off automático).
